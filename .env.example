# Copy to .env and fill in. Alerts and heartbeat are optional: without Telegram, alerts go to the log.
# Telegram: token from @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates
# after sending the bot a message. Test with `tbot notify`.
TBOT_TELEGRAM_TOKEN=
TBOT_TELEGRAM_CHAT_ID=
# Push URL of an external monitor (healthchecks.io, Uptime Kuma, ...) pinged every heartbeat_seconds.
TBOT_HEARTBEAT_URL=
# Binance API key for `tbot live`. Testnet keys come from https://testnet.binance.vision,
# production keys from the Binance API management page: enable spot trading only, no withdrawals,
# and restrict the key to this machine's IP if that IP is static.
TBOT_BINANCE_API_KEY=
TBOT_BINANCE_API_SECRET=
