# Copy to .env and fill in. Without Telegram, alerts go to the log: fine for paper and testnet,
# but `tbot live`, `tbot doctor`, and `tbot autostart` refuse a real-money config without it.
# Telegram: run `tbot notify` and follow it; it fills in these two lines and sends a test message.
TBOT_TELEGRAM_TOKEN=
TBOT_TELEGRAM_CHAT_ID=
# Push URL of an external monitor (healthchecks.io, Uptime Kuma, ...) pinged every heartbeat_seconds.
TBOT_HEARTBEAT_URL=
# Binance API key for `tbot live`; `tbot keys live` (or `tbot keys testnet`) asks for a pair,
# checks it with Binance, and fills in these lines. Testnet keys come from https://testnet.binance.vision,
# production keys from the Binance API management page: enable spot trading only, no withdrawals,
# and restrict the key to this machine's IP if that IP is static.
TBOT_BINANCE_API_KEY=
TBOT_BINANCE_API_SECRET=
# Optional: testnet keys of their own, so testnet keeps running once the pair above is a live key.
TBOT_BINANCE_TESTNET_API_KEY=
TBOT_BINANCE_TESTNET_API_SECRET=
